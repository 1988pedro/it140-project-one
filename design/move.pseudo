// Move Pseudocode for Archaeological Tomb Exploration

WHILE game_is_running == TRUE
    PRINT "You are currently in: " + current_room
    PRINT "Where would you like to go? (Enter north, south, east, west, or exit)"
    INPUT player_move
    
    IF player_move == "exit"
        PRINT "Thanks for playing!"
        SET game_is_running = FALSE
        
    ELSE IF player_move IS A VALID DIRECTION FOR current_room
        SET current_room = new_room_based_on_direction
        PRINT "You move successfully into the " + current_room
        
        // Check if player enters the Villain's room prematurely
        IF current_room == "Guardian's Sanctum" AND player_inventory.length < 6
            PRINT "The High Priest Mummy awakens and blocks your path! You were caught before collecting all the relics. Game Over!"
            SET game_is_running = FALSE
        END IF
        
    ELSE
        PRINT "You cannot go that way! Try a different direction."
    END IF
END WHILE
