// Get Item Pseudocode for Archaeological Tomb Exploration

WHILE game_is_running == TRUE
    PRINT "You are in room: " + current_room
    
    IF current_room CONTAINS AN ITEM AND item_is_not_collected
        PRINT "An artifact is present: " + item_name
        PRINT "Would you like to pick it up? (Enter 'get' or 'ignore')"
        INPUT player_action
        
        IF player_action == "get"
            ADD item_name TO player_inventory
            MARK item_name AS collected
            PRINT "You successfully collected the " + item_name + "!"
            PRINT "Current Inventory: " + player_inventory
            
            // Check win condition
            IF player_inventory.length == 6
                PRINT "You have collected all six sacred relics! Escape to safety to win!"
            END IF
            
        ELSE
            PRINT "You left the item behind."
        END IF
    ELSE
        PRINT "There are no items to collect in this room."
    END IF
    
    SET game_is_running = FALSE
END WHILE
